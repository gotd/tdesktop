# Generates the lang key name table of UI tracing (trace/trace_lang_names.h)
# from codegen_lang's key slots: IN is gen/lang_auto.indices
# ("name<TAB>start<TAB>size" per key), OUT the .cpp to write.
# Run with cmake -DIN=... -DOUT=... -P trace_lang_names.cmake.

set(body "")
set(count 0)
if (EXISTS "${IN}")
    file(STRINGS "${IN}" lines)
    foreach (line IN LISTS lines)
        if (line MATCHES "^([A-Za-z0-9_]+)\t([0-9]+)\t([0-9]+)$")
            string(APPEND body
                "\t{ ${CMAKE_MATCH_2}, ${CMAKE_MATCH_3}, \"${CMAKE_MATCH_1}\" },\n")
            math(EXPR count "${count} + 1")
        endif()
    endforeach()
endif()
if (count EQUAL 0)
    set(body "\t{ 0, 0, nullptr },\n")
endif()

set(content "// Generated by Telegram/cmake/trace_lang_names.cmake, do not edit.
#include \"trace/trace_lang_names.h\"

namespace Trace::Ui::details {

extern const LangName kLangNames[] = {
${body}};
extern const int kLangNamesCount = ${count};

} // namespace Trace::Ui::details
")
file(WRITE "${OUT}.tmp" "${content}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
